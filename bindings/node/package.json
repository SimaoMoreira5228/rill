    "native/**/*",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SimaoMoreira5228/rill.git",
    "directory": "bindings/node"
  },
  "homepage": "https://github.com/SimaoMoreira5228/rill",
  "bugs": {
    "url": "https://github.com/SimaoMoreira5228/rill/issues"
  },
  "keywords": [
    "rill",
    "media",
    "video",
    "audio",
    "download",
    "extractor",
    "yt-dlp",
    "youtube-dl",
    "youtube-downloader",
    "media-downloader",
    "video-downloader",
    "audio-downloader",
    "crystal"
  ],
  "scripts": {
    "prepack": "node scripts/prepack.js",
    "install": "node scripts/install.js",
    "package-native": "node scripts/package-native.js",
